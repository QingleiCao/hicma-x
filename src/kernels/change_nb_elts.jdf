extern "C" %{
/**
 * @file change_nb_elts.jdf
 * @brief Update the byte count recorded for every matrix tile
 */
#include "hicma_parsec.h"

%}

descA        [ type = "parsec_tiled_matrix_t *" ]
element_size [ type = "size_t" ]

Change_nb_elts(m, n)

m = 0 .. descA->lmt-1
n = 0 .. descA->lnt-1

: descA(m, n)

READ A <- descA(m, n)

BODY
{
    (void)A;
    this_task->data._f_A.data_out->original->nb_elts =
        descA->mb * descA->nb * element_size;
}
END

extern "C" %{

parsec_taskpool_t *
parsec_change_nb_elts_New(parsec_tiled_matrix_t *A, size_t element_size)
{
    parsec_change_nb_elts_taskpool_t *taskpool =
        parsec_change_nb_elts_new(A, element_size);

    parsec_add2arena(
        &taskpool->arenas_datatypes[PARSEC_change_nb_elts_DEFAULT_ADT_IDX],
        parsec_datatype_int8_t, PARSEC_MATRIX_FULL,
        1, A->mb * element_size, A->nb, A->mb * element_size,
        PARSEC_ARENA_ALIGNMENT_SSE, -1);

    return (parsec_taskpool_t *)taskpool;
}

void
parsec_change_nb_elts_Destruct(parsec_taskpool_t *taskpool)
{
    parsec_change_nb_elts_taskpool_t *change_nb_elts_taskpool =
        (parsec_change_nb_elts_taskpool_t *)taskpool;

    parsec_del2arena(
        &change_nb_elts_taskpool
             ->arenas_datatypes[PARSEC_change_nb_elts_DEFAULT_ADT_IDX]);
    parsec_taskpool_free(taskpool);
}

int
parsec_change_nb_elts(parsec_context_t *parsec,
                      parsec_tiled_matrix_t *A,
                      size_t element_size)
{
    parsec_taskpool_t *taskpool =
        parsec_change_nb_elts_New(A, element_size);

    if (NULL != taskpool) {
        parsec_context_add_taskpool(parsec, taskpool);
        parsec_context_start(parsec);
        parsec_context_wait(parsec);
        parsec_change_nb_elts_Destruct(taskpool);
    }

    return 0;
}

%}
